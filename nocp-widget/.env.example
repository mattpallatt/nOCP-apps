# Copy to .env and fill in — .env is gitignored, this example file is not.
#
# These are BOOTSTRAP values only, read by deploy.sh for the first deploy
# (or a disaster-recovery redeploy where DynamoDB itself was lost). Once
# deployed, the live source of truth is the settings page at
# https://<your-function-url>/admin — title and both tokens can be
# viewed and rotated there without ever touching this file or redeploying.
# If you rotate a token there, update it here too if you want this file to
# stay an accurate local reference — nothing keeps them in sync automatically.
#
# Generate a token with: openssl rand -hex 32

NOCP_FRAME_TOKEN=
NOCP_ADMIN_TOKEN=
NOCP_TITLE=nOCP
