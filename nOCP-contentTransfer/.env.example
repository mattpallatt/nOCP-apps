# Copy to .env and fill in — .env is gitignored, this example file is not.
#
# These are BOOTSTRAP values only, read by deploy.sh for the first deploy
# (or a disaster-recovery redeploy where the DynamoDB item itself was
# deleted). Once deployed, the live source of truth is the settings page at
# https://<your-function-url>/admin — title and both tokens can be viewed
# and rotated there without ever touching this file or redeploying. Every
# environment's CMAPI/Content Graph credentials are NOT set here at all —
# they only ever live in the settings page (Environment 1/2/3 sections).
#
# Generate a token with: openssl rand -hex 32

NOCP_FRAME_TOKEN=
NOCP_ADMIN_TOKEN=
NOCP_TITLE=Content Transfer
