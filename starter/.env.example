# Copy to .env and fill in — .env is gitignored, this example file is not.
#
# Unlike the full nocp-widget app one directory up, there's no settings
# page here to rotate these live — this starter has no persistence beyond
# in-memory webhook events (see README "Why there's no /admin here"), so
# these are read directly from the environment on every request. Rotating
# a token means updating it here (or in your host's env var config) and
# redeploying/restarting.
#
# Generate a token with: openssl rand -hex 32

NOCP_FRAME_TOKEN=
NOCP_TITLE=nOCP
