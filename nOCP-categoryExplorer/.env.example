# Copy to .env and fill in — .env is gitignored, this example file is not.
#
# These are BOOTSTRAP values only, read by deploy.sh for the first deploy
# (or a disaster-recovery redeploy where the SSM parameter itself was
# deleted). Once deployed, the live source of truth is the settings page at
# https://<your-function-url>/admin — title, both tokens, and the Optimizely
# Graph Single Key can be viewed and rotated there without ever touching
# this file or redeploying.
#
# Generate a token with: openssl rand -hex 32

NOCP_FRAME_TOKEN=
NOCP_ADMIN_TOKEN=
NOCP_TITLE=Category Explorer
